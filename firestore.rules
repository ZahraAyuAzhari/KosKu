rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Setiap pemilik hanya boleh membaca dan menulis data miliknya sendiri.
    match /owners/{uid} {
      allow read, write: if owner(uid);

      match /kamar/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.no is string && request.resource.data.no.size() > 0
          && request.resource.data.harga is number && request.resource.data.harga >= 0;
      }
      match /bayar/{id} { allow read, write: if owner(uid); }
      match /biaya/{id} { allow read, write: if owner(uid); }
    }
  }
}
